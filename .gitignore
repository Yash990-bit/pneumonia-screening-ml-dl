# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python packaging artifacts
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Jupyter
.ipynb_checkpoints/

# Environment files, credentials, and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/
kaggle.json
.kaggle/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Local editor settings
.idea/
.vscode/
*.swp
*.swo

# Datasets and derived data (retain documentation)
data/raw/**
data/processed/**
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model checkpoints and serialized training artifacts
*.pt
*.pth
*.ckpt
*.onnx
results/models/**
!results/models/.gitkeep

# Generated figures and transient experiment output
results/figures/**
!results/figures/.gitkeep
results/**/runs/
results/**/logs/
wandb/
runs/

# Keep lightweight result summaries under results/metrics trackable.
# Detailed dataset-audit inventories are reproducible generated artifacts.
results/dataset_audit/image_metadata.csv
results/dataset_audit/duplicate_report.csv
results/dataset_audit/cross_split_duplicates.csv
results/dataset_audit/corrupt_files.csv
results/dataset_audit/structure_issues.csv

# Temp config patch written by scripts/extract_features.py CLI overrides
configs/_patched_config.yaml
